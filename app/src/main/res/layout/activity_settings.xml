<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- 1. Token de Blynk -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Token de Blynk"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtToken"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/borde_caja"
            android:inputType="textNoSuggestions"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- 2. Intervalo de sondeo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Intervalo de sondeo (s)"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtIntervalo"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/borde_caja"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="18dp" />

        <!-- 3. Umbral de alerta -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Umbral de alerta (g)"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtUmbral"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/borde_caja"
            android:inputType="numberDecimal"
            android:paddingHorizontal="12dp"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- 4. Botón Probar Conexión -->
        <Button
            android:id="@+id/btnProbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="PROBAR CONEXIÓN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:backgroundTint="#337AB7"
            android:layout_marginBottom="16dp" />

        <!-- 5. Texto de Resultado -->
        <TextView
            android:id="@+id/txtResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conexión correcta"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible"
            android:layout_marginBottom="20dp" />

        <!-- 6. Botón Cerrar Sesión -->
        <Button
            android:id="@+id/btnSalir"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="CERRAR SESIÓN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            android:backgroundTint="#337AB7" />

    </LinearLayout>
</ScrollView>